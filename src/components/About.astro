---

<section id="about" class="about" aria-labelledby="about-title">
	<h2 id="about-title" class="sr-only">About</h2>
	<div class="avatar" data-avatar>
		<img class="face face--front" src={ABOUT.PHOTO_PIXEL} alt="" width="256" height="256" loading="lazy" />
		<img class="face" src={ABOUT.PHOTO} alt="Portrait" width="256" height="256" loading="lazy" />
	</div>

	<div class="copy">
		<div class="icons">
			{
				ABOUT.SOCIALS.map((s) => (
					<a
						href={s.HREF}
						target={s.HREF.startsWith("mailto:") ? undefined : "_blank"}
						rel="noopener"
						aria-label={s.NAME}
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							{icons[s.NAME].map((d) => (
								<path d={d} fill-rule="evenodd" clip-rule="evenodd" />
							))}
						</svg>
					</a>
				))
			}
		</div>

		{ABOUT.PARAGRAPHS.map((p) => <p>{p}</p>)}
	</div>
</section>

<script>
	// The avatar's corners round from 10% to a full circle as it scrolls in.
	const avatar = document.querySelector<HTMLElement>("[data-avatar]")!;
	const thresholds = Array.from({ length: 41 }, (_, i) => i / 40);
	new IntersectionObserver(
		([entry]) => {
			const ratio = entry.intersectionRatio;
			const radius = ratio >= 1 ? 50 : Math.max(10, ratio * 50);
			avatar.style.setProperty("--radius", `${radius}%`);
		},
		{ threshold: thresholds },
	).observe(avatar.parentElement!);
</script>

<style>
	.about {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 90%;
		max-width: 840px;
		margin-inline: auto;
		padding-top: 7rem;
		padding-bottom: 9rem;
		scroll-margin-top: 4rem;
	}

	.avatar {
		--radius: 50%;
		position: relative;
		width: 16rem;
		height: 16rem;
		cursor: pointer;
	}
	.face {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--radius);
		transition: all 0.3s;
	}
	.face--front {
		z-index: 1;
		backface-visibility: hidden;
		image-rendering: pixelated;
	}
	.avatar:hover .face {
		transform: rotateY(180deg);
	}

	.copy {
		font-family: "Bree Serif", Georgia, serif;
		font-size: 1.5rem;
		line-height: 2rem;
		word-spacing: 0.25rem;
		color: var(--ink);
	}
	.copy p + p {
		margin-top: 1.5rem;
	}

	.icons {
		display: flex;
		align-items: center;
		justify-content: center;
		column-gap: 0.75rem;
		margin-top: 4rem;
		margin-bottom: 2.5rem;
	}
	.icons a {
		padding: 0.25rem;
		border: 2px solid var(--ink);
		border-radius: 0.5rem;
		color: var(--ink);
		cursor: pointer;
		transition: all 0.15s;
	}
	.icons a:hover {
		transform: scale(1.1);
	}
	.icons svg {
		display: block;
		width: 1.75rem;
		height: 1.75rem;
		fill: currentColor;
	}

	@media (max-width: 600px) {
		.copy {
			font-size: 1.25rem;
			line-height: 1.75rem;
		}
	}
</style>
