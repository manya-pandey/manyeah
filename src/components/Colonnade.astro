---
// "Click to add a brick" on the section pages. There's no button as such:
// the dashed outline of five bricks in the bottom-right corner is the thing
// you click. Each click lays one brick; the fifth turns the course into a
// marble column that rises up the page (fading out above the bottom quarter
// of the screen), and the empty outline steps a little to the left to start
// the next one. Progress is kept in this browser, across all section pages.
const PER_COLUMN = 5;
---

<div class="colonnade" data-colonnade aria-hidden="true"></div>

<button
	type="button"
	class="course"
	data-course
	data-per={PER_COLUMN}
	aria-label="Lay a brick"
	title="Click to add a brick"
>
	{Array.from({ length: PER_COLUMN }, () => <span class="slot" />)}
</button>

<script>
	const course = document.querySelector<HTMLButtonElement>("[data-course]")!;
	const colonnade = document.querySelector<HTMLElement>("[data-colonnade]")!;
	const PER = Number(course.dataset.per);
	const MAX_SHOWN = 6;
	const KEY = "bricks";
	const slots = [...course.querySelectorAll<HTMLElement>(".slot")];

	const read = () => {
		try {
			return Math.max(0, Number(localStorage.getItem(KEY)) || 0);
		} catch {
			return 0;
		}
	};
	const save = (n: number) => {
		try {
			localStorage.setItem(KEY, String(n));
		} catch {}
	};

	let count = read();

	function column() {
		const el = document.createElement("span");
		el.className = "column";
		el.innerHTML = '<span class="capital"></span><span class="shaft"></span><span class="base"></span>';
		return el;
	}

	function render() {
		const loose = count % PER;
		const columns = Math.floor(count / PER);
		slots.forEach((s, i) => s.classList.toggle("laid", i < loose));
		const shown = Math.min(columns, MAX_SHOWN);
		while (colonnade.children.length < shown) colonnade.appendChild(column());
		while (colonnade.children.length > shown) colonnade.lastElementChild!.remove();
		course.style.setProperty("--columns", String(shown));
		const next = PER - loose;
		course.setAttribute(
			"aria-label",
			`Lay a brick. ${columns} ${columns === 1 ? "column" : "columns"} built; ${next} more ${next === 1 ? "brick" : "bricks"} to the next.`,
		);
	}

	let busy = false;
	course.addEventListener("click", async () => {
		if (busy) return;
		busy = true;
		count += 1;
		save(count);
		const loose = count % PER;

		if (loose !== 0) {
			slots[loose - 1].classList.add("laid", "landing");
			setTimeout(() => slots[loose - 1].classList.remove("landing"), 400);
			render();
			busy = false;
			return;
		}

		// Fifth brick: set it, turn the course to marble, raise the column,
		// then let the empty outline step left.
		slots[PER - 1].classList.add("laid", "landing");
		await new Promise((r) => setTimeout(r, 350));
		course.classList.add("marbling");
		await new Promise((r) => setTimeout(r, 450));
		const shownBefore = colonnade.children.length;
		render();
		const fresh = colonnade.children[shownBefore] as HTMLElement | undefined;
		fresh?.classList.add("rising");
		course.classList.remove("marbling");
		slots.forEach((s) => s.classList.remove("landing"));
		busy = false;
	});

	render();
</script>

<style>
	.colonnade,
	.course {
		--brick: #a9502c;
		--brick-edge: #7d3a1f;
		--marble: #f7f4ee;
		--marble-shade: #a9a194;
		--col-w: 2.6rem;
		--col-gap: 0.55rem;
		--bottom: 1.25rem;
		--right: clamp(0.75rem, 2.5vw, 2rem);
	}

	/* Columns sit behind the page content; the outline sits above it. */
	.colonnade {
		position: fixed;
		right: var(--right);
		bottom: var(--bottom);
		z-index: 1;
		display: flex;
		flex-direction: row-reverse;
		gap: var(--col-gap);
		pointer-events: none;
	}
	.colonnade :global(.column) {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: var(--col-w);
		height: 55vh;
		transform-origin: bottom;
		/* solid in the bottom quarter of the screen, fading out above it */
		-webkit-mask-image: linear-gradient(
			to top,
			#000 0,
			#000 calc(25vh - var(--bottom)),
			transparent 100%
		);
		mask-image: linear-gradient(to top, #000 0, #000 calc(25vh - var(--bottom)), transparent 100%);
		filter: drop-shadow(2px 2px 0 color-mix(in oklab, var(--ink) 18%, transparent));
	}
	.colonnade :global(.column.rising) {
		animation: rise 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	@keyframes rise {
		from {
			transform: scaleY(0.12);
			filter: brightness(1.25);
		}
	}
	.colonnade :global(.capital),
	.colonnade :global(.base) {
		flex: none;
		width: 100%;
		height: 0.55rem;
		border: 1px solid var(--marble-shade);
		border-radius: 1px;
		background: var(--marble);
	}
	.colonnade :global(.capital) {
		width: 118%;
		box-shadow: 0 0.3rem 0 -0.1rem var(--marble-shade);
	}
	.colonnade :global(.base) {
		width: 118%;
	}
	.colonnade :global(.shaft) {
		flex: 1;
		width: 84%;
		border-inline: 1px solid var(--marble-shade);
		/* fluting */
		background:
			repeating-linear-gradient(
				90deg,
				transparent 0 18%,
				color-mix(in oklab, var(--marble-shade) 55%, transparent) 18% 23%
			),
			linear-gradient(90deg, #fff 0%, var(--marble) 30%, #cfc8bb 100%);
	}

	.course {
		position: fixed;
		right: calc(var(--right) + var(--columns, 0) * (var(--col-w) + var(--col-gap)));
		bottom: var(--bottom);
		z-index: 40;
		display: flex;
		flex-direction: column-reverse;
		gap: 2px;
		width: calc(var(--col-w) * 1.15);
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		transition: right 0.6s cubic-bezier(0.3, 0.9, 0.3, 1);
	}
	.slot {
		display: block;
		height: 0.7rem;
		border: 1.5px dashed color-mix(in oklab, var(--ink) 45%, transparent);
		border-radius: 2px;
		margin-inline: 0.35rem 0;
		transition:
			background-color 0.3s,
			border-color 0.3s;
	}
	.slot:nth-child(even) {
		margin-inline: 0 0.35rem;
	}
	.course:hover .slot:not(.laid),
	.course:focus-visible .slot:not(.laid) {
		border-color: var(--accent);
	}
	.slot.laid {
		border: 1px solid var(--brick-edge);
		background:
			linear-gradient(90deg, transparent 48%, rgb(0 0 0 / 0.2) 48% 52%, transparent 52%),
			var(--brick);
	}
	.slot.landing {
		animation: drop 0.35s cubic-bezier(0.5, 0, 0.6, 1.6);
	}
	@keyframes drop {
		from {
			transform: translateY(-1.6rem);
			opacity: 0;
		}
	}
	.course.marbling .slot {
		border-color: var(--marble-shade);
		background: var(--marble);
		margin-inline: 0;
	}

	@media (max-width: 640px) {
		.colonnade,
		.course {
			--col-w: 1.9rem;
			--col-gap: 0.4rem;
		}
		.slot {
			height: 0.55rem;
		}
	}
</style>
