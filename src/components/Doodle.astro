		"M27.2 19.6c3.4-.3 6.8-.3 9.6 0M27.4 25.2c2.6-.2 5.4-.2 7.6.1M27.3 30.6c1.6-.1 3.4-.1 4.8 0",
	],
};
---

<svg
	class:list={["doodle", className]}
	viewBox="0 0 48 48"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{paths[name].map((d) => <path d={d} />)}
</svg>
