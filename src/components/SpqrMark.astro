---
import { brace, LEAF } from "@/lib/spqr";

// The SPQR mark: { SPQR } with the curly braces drawn as laurel sprigs, and
// circuit traces and node dots growing out of them among the leaves. Colours
// come from the theme. SPQR here stands for Scientia Per Quaestionem
// Reperitur, "knowledge is found through questioning".
interface Props {
	class?: string;
	animated?: boolean;
}

const { class: className = "", animated = false } = Astro.props;
const braces = [brace("left"), brace("right")];
const letters = ["S", "P", "Q", "R"];
---

<svg
	class:list={["spqr", { "spqr--animated": animated }, className]}
	viewBox="0 0 260 110"
	role="img"
	aria-label="SPQR"
>
	{
		braces.map((b, side) => (
			<g class="sprig" style={`--side: ${side}`}>
				<path class="stem" pathLength="1" d={b.stem} />
				<g class="leaves">
					{b.leaves.map((l, i) => (
						<path
							class="leaf"
							d={LEAF}
							style={`--i: ${i}`}
							transform={`translate(${l.x} ${l.y}) rotate(${l.angle}) scale(${l.size})`}
						/>
					))}
				</g>
				<g class="circuit">
					{b.traces.map((d) => (
						<path class="trace" pathLength="1" d={d} />
					))}
					{b.nodes.map((n, i) => (
						<circle class="node" cx={n.x} cy={n.y} r={n.r} style={`--i: ${i}`} />
					))}
				</g>
			</g>
		))
	}
	<g class="word">
		<text class="ghost" x="131.3" y="70.2" text-anchor="middle">SPQR</text>
		<text class="main" x="130" y="69" text-anchor="middle">
			{letters.map((l, i) => <tspan style={`--i: ${i}`}>{l}</tspan>)}
		</text>
	</g>
</svg>

<style>
	.spqr {
		overflow: visible;
		color: var(--ink);
	}
	.stem {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.leaf {
		fill: var(--accent);
	}
	.trace {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.75;
	}
	.node {
		fill: currentColor;
	}
	.word text {
		font-family: var(--font-main);
		font-size: 40px;
		letter-spacing: 0.1em;
	}
	.main {
		fill: currentColor;
	}
	/* a faint offset copy in the accent, the old mark's glitch shadow */
	.ghost {
		fill: var(--accent);
		opacity: 0.3;
	}

	/* Load sequence: the stems grow, leaves unfurl, the circuit lights up,
	   then the letters glitch on. */
	.spqr--animated .stem,
	.spqr--animated .trace {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: draw 0.8s cubic-bezier(0.6, 0, 0.3, 1) forwards;
	}
	.spqr--animated .trace {
		animation-duration: 0.35s;
		animation-delay: 0.75s;
	}
	.spqr--animated .leaf,
	.spqr--animated .node {
		opacity: 0;
		transform-box: fill-box;
		transform-origin: 0 50%;
		animation: unfurl 0.35s ease-out forwards;
		animation-delay: calc(0.3s + var(--i) * 0.05s);
	}
	.spqr--animated .node {
		transform-origin: center;
		animation-name: node-pop;
		animation-delay: calc(0.95s + var(--i) * 0.07s);
	}
	.spqr--animated .main tspan {
		fill-opacity: 0;
		animation: set 0.3s steps(2) forwards;
		animation-delay: calc(1.15s + var(--i) * 0.1s);
	}
	.spqr--animated .ghost {
		opacity: 0;
		animation: glitch 0.6s steps(1) 1.15s forwards;
	}
	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes unfurl {
		from {
			opacity: 0;
			scale: 0.2;
		}
		to {
			opacity: 1;
			scale: 1;
		}
	}
	@keyframes node-pop {
		0% {
			opacity: 0;
			scale: 0;
		}
		70% {
			opacity: 1;
			scale: 1.6;
		}
		100% {
			opacity: 1;
			scale: 1;
		}
	}
	@keyframes set {
		to {
			fill-opacity: 1;
		}
	}
	@keyframes glitch {
		0% {
			opacity: 0.7;
			transform: translateX(5px);
		}
		25% {
			opacity: 0;
		}
		45% {
			opacity: 0.7;
			transform: translateX(-4px);
		}
		70%,
		100% {
			opacity: 0.3;
			transform: none;
		}
	}
</style>
