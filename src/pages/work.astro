---
import Entry from "@/components/Entry.astro";
import Section from "@/layouts/Section.astro";
import { getCollection, render } from "astro:content";

const items = (await getCollection("work")).sort((a, b) => +b.data.date - +a.data.date);
const groups = [
	{ heading: "Internships", items: items.filter((i) => i.data.kind === "internship") },
	{ heading: "Projects", items: items.filter((i) => i.data.kind === "project") },
].filter((g) => g.items.length);
---

<Section section="work">
	{
		groups.map(async (group) => (
			<section class="mb-10">
				<h2 class="mb-1 text-xl text-muted">{group.heading}</h2>
				{group.items.map(async (item) => {
					const { Content } = await render(item);
					return (
						<Entry
							title={item.data.title}
							href={item.data.link}
							meta={[item.data.role, item.data.org, item.data.period]}
						>
							<Content />
						</Entry>
					);
				})}
			</section>
		))
	}
</Section>
