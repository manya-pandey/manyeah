	// quill over a scroll
	blogs: [
		"M10.5 15.2c6.5-.7 18.8-.8 25.3-.1 1.8.2 2.6 2.5.9 3.3-.8 6-.8 14.2-.2 19.8-6.6.9-19.3.8-25.6.1-1.9-.2-2.4-2.6-.6-3.3.5-6.2.6-13.9.2-19.8z",
		"M14.8 22h9.5M14.6 26.6h7.4M14.9 31h5",
