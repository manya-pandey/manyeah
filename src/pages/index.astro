---
import BrickWall from "@/components/BrickWall.astro";
import DoodleNav from "@/components/DoodleNav.astro";
import Loader from "@/components/Loader.astro";
import Statue from "@/components/Statue.astro";
import { SITE, STATUE } from "@/consts";
import Base from "@/layouts/Base.astro";
---

<Base>
	<Loader />
	<Statue />

	<div class="landing">
		<header class="top">
			<DoodleNav />
		</header>

		<main class="hero">
			<h1 class="name">{SITE.NAME}</h1>
			<p class="intro">{SITE.INTRO}</p>
			{SITE.TAGLINE && <p class="tagline">{SITE.TAGLINE}</p>}
			<a class="resume" href={SITE.RESUME}>
				résumé
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18.5 5.5M9 5h10v10" /></svg>
			</a>
		</main>

		<footer class="bottom">
			{
				STATUE.CREDIT_URL ? (
					<a class="credit" href={STATUE.CREDIT_URL} rel="noopener">
						statue: {STATUE.CREDIT}
					</a>
				) : (
					<span class="credit">statue: {STATUE.CREDIT}</span>
				)
			}
			<BrickWall />
		</footer>
	</div>
</Base>

<style>
	.landing {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-rows: auto 1fr auto;
		grid-template-areas:
			"top"
			"hero"
			"bottom";
		min-height: 100dvh;
		padding: clamp(1rem, 3vw, 2.25rem) clamp(1rem, 4vw, 3.5rem);
		gap: 1rem;
	}

	.top {
		grid-area: top;
		max-width: 64rem;
		width: 100%;
		margin-inline: auto;
	}

	.hero {
		grid-area: hero;
		align-self: center;
		max-width: 34rem;
		padding-left: clamp(0rem, 6vw, 7rem);
	}
	.name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(3rem, 9vw, 6.5rem);
		line-height: 0.95;
		letter-spacing: 0.04em;
	}
	.intro {
		margin-top: 1rem;
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		line-height: 1.4;
		color: var(--ink);
		max-width: 26rem;
	}
	.tagline {
		margin-top: 0.4rem;
		font-style: italic;
		color: var(--muted);
	}
	.resume {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 1.4rem;
		padding-bottom: 0.1rem;
		border-bottom: 1.5px solid var(--accent);
		color: var(--accent);
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 0.95rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
	}
	.resume svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		transition: transform 0.2s ease;
	}
	.resume:hover svg {
		transform: translate(2px, -2px);
	}

	.bottom {
		grid-area: bottom;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: end;
		gap: 1rem;
	}
	.bottom :global(.lay) {
		justify-self: center;
		margin-bottom: 1.6rem;
	}
	.bottom :global(.column) {
		justify-self: end;
	}
	.credit {
		justify-self: start;
		align-self: end;
		font-size: 0.8rem;
		color: var(--muted);
		opacity: 0.7;
		text-decoration: none;
	}
	.credit:hover {
		opacity: 1;
		text-decoration: underline;
	}

	@media (max-width: 720px) {
		.hero {
			padding-left: 0;
		}
		.bottom {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				"lay column"
				"credit column";
		}
		.bottom :global(.lay) {
			grid-area: lay;
			justify-self: start;
			margin-bottom: 0;
		}
		.bottom :global(.column) {
			grid-area: column;
		}
		.credit {
			grid-area: credit;
		}
	}
</style>
