---
import { getWhoami } from "@/lib/whoami";
import { SITE, THEMES } from "@/consts";
import ContactCard from "@/components/ContactCard.astro";
import "@/styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const me = await getWhoami();
const { title, description = SITE.DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} · ${me.name}` : me.name;
const themeIds = { light: THEMES.LIGHT.ID, dark: THEMES.DARK.ID };
const presetIds = Object.values(THEMES).map((t) => t.ID);
---

<!doctype html>
<html lang="en" data-palette={THEMES.LIGHT.ID}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

		<!-- The SPQR mark: brackets and letters at 64 and 32px, simpler at 16px. -->
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<!--
			Theme engine. Runs before first paint so a saved theme never flashes.
			A choice is "auto" (cream or midnight, following the system), a preset
			id, or a custom { a, b } pair of hex colours. The theme
			menu drives it through window.siteTheme.
		-->
		<script is:inline define:vars={{ themeIds, presetIds }}>
			(() => {
				const root = document.documentElement;
				const KEY = "theme";
				const darkQuery = matchMedia("(prefers-color-scheme: dark)");
				const CUSTOM_VARS = ["--a", "--b", "--ink", "--muted", "--statue-opacity", "--statue-light", "--statue-ambient", "--texture-opacity", "color-scheme"];

				const hexToRgb = (hex) => {
					let h = hex.replace("#", "");
					if (h.length === 3) h = [...h].map((c) => c + c).join("");
					return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16));
				};
				const rgbToHex = (rgb) =>
					"#" + rgb.map((v) => Math.round(Math.min(255, Math.max(0, v))).toString(16).padStart(2, "0")).join("");
				const hexToHsl = (hex) => {
					const [r, g, b] = hexToRgb(hex).map((v) => v / 255);
					const max = Math.max(r, g, b), min = Math.min(r, g, b), l = (max + min) / 2;
					if (max === min) return [0, 0, Math.round(l * 100)];
					const d = max - min;
					const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
					let h = max === r ? (g - b) / d + (g < b ? 6 : 0) : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
					return [Math.round(h * 60), Math.round(s * 100), Math.round(l * 100)];
				};
				const hslToHex = ([h, s, l]) => {
					s /= 100;
					l /= 100;
					const k = (n) => (n + h / 30) % 12;
					const a = s * Math.min(l, 1 - l);
					const f = (n) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
					return rgbToHex([f(0), f(8), f(4)].map((v) => v * 255));
				};
				const luminance = (hex) => {
					const [r, g, b] = hexToRgb(hex).map((v) => {
						v /= 255;
						return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
					});
					return 0.2126 * r + 0.7152 * g + 0.0722 * b;
				};
				const isHex = (v) => /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v);

				const read = () => {
					try {
						const saved = JSON.parse(localStorage.getItem(KEY) ?? "null");
						if (saved === "auto" || presetIds.includes(saved)) return saved;
						if (saved && isHex(saved.a) && isHex(saved.b)) return saved;
					} catch {}
					return "auto";
				};

				let choice = read();

				function paint() {
					CUSTOM_VARS.forEach((v) => root.style.removeProperty(v));
					if (typeof choice === "string") {
						root.dataset.palette = choice === "auto" ? themeIds[darkQuery.matches ? "dark" : "light"] : choice;
						return;
					}
					// Custom: derive readable text and statue lighting from the two picks.
					const { a, b } = choice;
					const light = luminance(a) > 0.3;
					const [h, s] = hexToHsl(a);
					const set = (k, v) => root.style.setProperty(k, v);
					set("--a", a);
					set("--b", b);
					set("--ink", hslToHex([h, Math.min(s, 30), light ? 13 : 92]));
					set("--muted", "color-mix(in oklab, var(--ink) 62%, var(--a))");
					set("--statue-opacity", light ? "0.42" : "0.6");
					set("--statue-ambient", light ? "0.25" : "0.7");
					set("--statue-light", rgbToHex(hexToRgb(b).map((v) => v * 0.25 + 255 * 0.75)));
					set("--texture-opacity", light ? "0.07" : "0.05");
					set("color-scheme", light ? "light" : "dark");
					root.dataset.palette = "custom";
				}

				darkQuery.addEventListener("change", () => choice === "auto" && paint());
				paint();

				window.siteTheme = {
					ids: themeIds,
					get choice() {
						return choice;
					},
					choose(next, { save = true } = {}) {
						choice = next;
						paint();
						if (save) {
							try {
								localStorage.setItem(KEY, JSON.stringify(next));
							} catch {}
						}
						window.dispatchEvent(new Event("theme:change"));
					},
					hexToHsl,
					hslToHex,
					isHex,
				};
			})();
		</script>
		<slot name="head" />
	</head>
	<body class="min-h-dvh">
		<div class="grain" aria-hidden="true"></div>
		<slot />
		<ContactCard />
	</body>
</html>
