---
import About from "@/components/About.astro";
import DoodleNav from "@/components/DoodleNav.astro";
import Loader from "@/components/Loader.astro";
import SiteMenu from "@/components/SiteMenu.astro";
import Statue from "@/components/Statue.astro";
import { ABOUT, SITE, STATUE } from "@/consts";
import Base from "@/layouts/Base.astro";
---

<Base>
	<Loader />
	<Statue />

	<header class="top" data-top>
		<div class="top-inner">
			<DoodleNav />
			<SiteMenu />
		</div>
	</header>

	<main>
		<div class="landing">
			<div class="hero">
				<h1 class="name">{SITE.NAME}</h1>
				<p class="intro">{SITE.INTRO}</p>
				{SITE.TAGLINE && <p class="tagline">{SITE.TAGLINE}</p>}
				<a class="resume" href={SITE.RESUME}>
					résumé
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18.5 5.5M9 5h10v10" /></svg>
				</a>
			</div>

			<div class="bottom">
				{
					STATUE.CREDIT_URL ? (
						<a class="credit" href={STATUE.CREDIT_URL} rel="noopener">
							statue: {STATUE.CREDIT}
						</a>
					) : (
						<span class="credit">statue: {STATUE.CREDIT}</span>
					)
				}
				<div class="actions">
					<a class="box" href="#about">
						<span>scroll</span>
						<svg class="arrow-down" viewBox="0 0 24 32" aria-hidden="true">
							<path d="M12.2 3.5c-.4 7.8-.3 15.6.1 23.6M4.6 19.4c2.6 2.6 5 5.2 7.6 8.1 2.4-2.9 4.8-5.6 7.4-8" />
						</svg>
					</a>
					<a class="box" href={`mailto:${ABOUT.EMAIL}`}>
						<svg class="envelope" viewBox="0 0 32 24" aria-hidden="true">
							<path d="M3.4 4.2c8.6-.6 17-.7 25.4-.1.6 5.4.5 10.8-.1 16.2-8.4.6-16.8.6-25.2 0-.6-5.4-.7-10.8-.1-16.1z" />
							<path d="M3.8 4.8c4 3.4 8 6.4 12.2 9.2 4.2-2.8 8.2-5.8 12.4-9.4" />
						</svg>
						<span>contact</span>
					</a>
				</div>
			</div>
		</div>

		<About />
	</main>

	<!-- Once the visitor reaches the end, point them back at the nav. -->
	<div class="end-hint" data-end-hint>
		<svg viewBox="0 0 60 70" aria-hidden="true">
			<path d="M40 66c-14-4-26-16-26-34 0-9 2-17 6-25" />
			<path d="M10.6 15.4c3-3.6 6.2-7.4 9.6-11 2 4.4 3.8 8.8 5.2 13.4" />
		</svg>
		<p>Now pick a page up here to see the rest.</p>
	</div>
</Base>

<script>
	const top = document.querySelector<HTMLElement>("[data-top]")!;
	const hint = document.querySelector<HTMLElement>("[data-end-hint]")!;
	function onScroll() {
		top.classList.toggle("is-stuck", window.scrollY > 12);
		const atEnd =
			window.scrollY > 40 &&
			window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 60;
		hint.classList.toggle("is-shown", atEnd);
	}
	window.addEventListener("scroll", onScroll, { passive: true });
	window.addEventListener("resize", onScroll);
	onScroll();
</script>

<style>
	/* The nav stays pinned to the top and tightens up once the page scrolls. */
	.top {
		position: sticky;
		top: 0;
		z-index: 30;
		padding: clamp(1rem, 3vw, 2.25rem) clamp(1rem, 4vw, 3.5rem) 0.5rem;
		transition:
			padding 0.25s ease,
			background-color 0.25s ease,
			box-shadow 0.25s ease;
	}
	.top-inner {
		display: flex;
		align-items: flex-start;
		gap: 1.5rem;
		max-width: 68rem;
		margin-inline: auto;
	}
	.top-inner :global(.doodle-nav) {
		flex: 1;
		min-width: 0;
	}
	.top.is-stuck {
		padding-top: 0.6rem;
		padding-bottom: 0.4rem;
		background: var(--bg);
		box-shadow: 0 1.5px 0 var(--line);
	}
	/* the pinned bar carries the same texture as the page behind it */
	.top.is-stuck::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		opacity: var(--texture-opacity);
		background: url("/background.png") repeat;
		background-size: 200px 200px;
		pointer-events: none;
	}
	.top.is-stuck :global(.doodle-nav .icon) {
		width: 2rem;
		height: 2rem;
	}
	.top.is-stuck :global(.doodle-nav .bracket) {
		height: 2.4rem;
	}
	.top.is-stuck :global(.doodle-nav a) {
		font-size: 1.3rem;
	}
	.top :global(.doodle-nav .icon),
	.top :global(.doodle-nav .bracket),
	.top :global(.doodle-nav a) {
		transition: all 0.25s ease;
	}

	.landing {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-rows: 1fr auto;
		/* the first screen, under the header */
		min-height: calc(100dvh - 8.5rem);
		padding: 1rem clamp(1rem, 4vw, 3.5rem) clamp(1rem, 3vw, 2.25rem);
		gap: 1rem;
	}

	.hero {
		align-self: center;
		max-width: 34rem;
		padding-left: clamp(0rem, 6vw, 7rem);
	}
	.name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(3rem, 9vw, 6.5rem);
		line-height: 0.95;
		letter-spacing: 0.04em;
	}
	.intro {
		margin-top: 1rem;
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		line-height: 1.4;
		color: var(--ink);
		max-width: 26rem;
	}
	.tagline {
		margin-top: 0.4rem;
		font-style: italic;
		color: var(--muted);
	}
	.resume {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 1.4rem;
		padding-bottom: 0.1rem;
		border-bottom: 1.5px solid var(--accent);
		color: var(--accent);
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 0.95rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
	}
	.resume svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		transition: transform 0.2s ease;
	}
	.resume:hover svg {
		transform: translate(2px, -2px);
	}

	.bottom {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: end;
		gap: 1rem;
	}
	.credit {
		justify-self: start;
		font-size: 0.8rem;
		color: var(--muted);
		opacity: 0.7;
		text-decoration: none;
	}
	.credit:hover {
		opacity: 1;
		text-decoration: underline;
	}

	/* Scroll and contact boxes, bottom centre. */
	.actions {
		display: flex;
		gap: 0.9rem;
		margin-bottom: 1.4rem;
	}
	.box {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.5rem 0.95rem;
		border: 1.5px solid var(--ink);
		border-radius: 3px 6px 4px 7px / 6px 3px 7px 4px;
		background: color-mix(in oklab, var(--bg) 85%, transparent);
		box-shadow: 3px 3px 0 var(--ink);
		color: var(--ink);
		font-family: var(--font-hand);
		font-size: 1.45rem;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition:
			transform 0.12s ease,
			box-shadow 0.12s ease,
			color 0.15s;
	}
	.box:hover {
		transform: translate(-1px, -1px);
		box-shadow: 4px 4px 0 var(--accent);
		color: var(--accent);
	}
	.box:active {
		transform: translate(2px, 2px);
		box-shadow: 1px 1px 0 var(--ink);
	}
	.box svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.arrow-down {
		width: 1rem;
		height: 1.4rem;
		animation: nudge 1.6s ease-in-out infinite;
	}
	.envelope {
		width: 1.6rem;
		height: 1.2rem;
	}
	@keyframes nudge {
		0%,
		100% {
			transform: translateY(-2px);
		}
		50% {
			transform: translateY(4px);
		}
	}

	/* "Now pick a page" hint, pointing up at the pinned nav. */
	.end-hint {
		position: fixed;
		top: 5.6rem;
		left: 50%;
		z-index: 25;
		display: flex;
		align-items: flex-start;
		gap: 0.4rem;
		translate: -50% 0;
		color: var(--accent);
		pointer-events: none;
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
	}
	.end-hint.is-shown {
		opacity: 1;
		transform: none;
	}
	.end-hint svg {
		width: 2.6rem;
		height: 3rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
		flex: none;
	}
	.end-hint p {
		margin-top: 1.4rem;
		max-width: 15rem;
		padding: 0.45rem 0.75rem 0.5rem;
		border: 1.5px solid currentColor;
		border-radius: 4px 9px 5px 8px / 9px 4px 8px 5px;
		background: var(--bg);
		box-shadow: 3px 3px 0 var(--line);
		font-family: var(--font-hand);
		font-size: 1.5rem;
		line-height: 1.1;
		text-wrap: balance;
	}

	@media (max-width: 720px) {
		.hero {
			padding-left: 0;
		}
		.bottom {
			grid-template-columns: 1fr;
			justify-items: start;
		}
		.actions {
			margin-bottom: 0;
		}
	}
	@media (max-width: 640px) {
		.top-inner {
			gap: 0.4rem;
		}
		.top :global(.site-menu .burger) {
			width: 2.4rem;
			height: 2.4rem;
		}
		.end-hint {
			top: 4.8rem;
		}
	}
</style>
