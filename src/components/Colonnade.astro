---
// "Click to add a brick" on the section pages. There's no button as such:
// the dashed outline of five bricks is the thing you click. Each click lays
// one brick; the fifth turns the course into a marble column that rises up
// the page (fading out above the bottom quarter of the screen), and the
// outline steps left to the next spot.
//
// Columns only stand in the empty margins either side of the text, never
// behind it. They fill right to left: the right margin from the screen edge
// inwards, then the left margin from beside the text out to the far edge.
// When every spot is taken the colonnade fades and starts again from zero.
// Progress is kept in this browser, across all section pages.
const PER_COLUMN = 5;
---

<div class="colonnade" data-colonnade aria-hidden="true"></div>

<button
	type="button"
	class="course"
	data-course
	data-per={PER_COLUMN}
	aria-label="Lay a brick"
	title="Click to add a brick"
	hidden
>
	{Array.from({ length: PER_COLUMN }, () => <span class="slot" />)}
</button>

<script>
	const course = document.querySelector<HTMLButtonElement>("[data-course]")!;
	const colonnade = document.querySelector<HTMLElement>("[data-colonnade]")!;
	const text = document.querySelector<HTMLElement>("[data-text-column]");
	const PER = Number(course.dataset.per);
	const KEY = "bricks";
	const slots = [...course.querySelectorAll<HTMLElement>(".slot")];

	const read = () => {
		try {
			return Math.max(0, Number(localStorage.getItem(KEY)) || 0);
		} catch {
			return 0;
		}
	};
	const save = (n: number) => {
		try {
			localStorage.setItem(KEY, String(n));
		} catch {}
	};

	let count = read();
	// Left edges (px) of each spot a column can stand in, in fill order.
	let spots: number[] = [];

	function measure() {
		const css = getComputedStyle(course);
		const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
		const width = course.getBoundingClientRect().width || 3 * rem;
		const gap = parseFloat(css.getPropertyValue("--col-gap")) * rem;
		const edge = parseFloat(css.getPropertyValue("--edge")) * rem;
		const clear = 0.75 * rem; // breathing room next to the text
		const vw = document.documentElement.clientWidth;
		const box = text?.getBoundingClientRect();
		const pad = text ? parseFloat(getComputedStyle(text).paddingLeft) : 0;
		const textLeft = box ? box.left + pad : vw / 2;
		const textRight = box ? box.right - pad : vw / 2;
		const pitch = width + gap;

		spots = [];
		// right margin: from the screen edge inwards
		for (let x = vw - edge - width; x >= textRight + clear; x -= pitch) spots.push(x);
		// left margin: from beside the text out to the screen edge
		for (let x = textLeft - clear - width; x >= edge; x -= pitch) spots.push(x);
	}

	function column(x: number) {
		const el = document.createElement("span");
		el.className = "column";
		el.style.left = `${x}px`;
		el.innerHTML = '<span class="capital"></span><span class="shaft"></span><span class="base"></span>';
		return el;
	}

	function render() {
		const loose = count % PER;
		const columns = Math.floor(count / PER);
		const fits = spots.length > 0;
		course.hidden = !fits;
		colonnade.hidden = !fits;
		if (!fits) return;

		slots.forEach((s, i) => s.classList.toggle("laid", i < loose));
		const shown = Math.min(columns, spots.length);
		const existing = [...colonnade.children] as HTMLElement[];
		existing.slice(shown).forEach((c) => c.remove());
		for (let i = 0; i < shown; i++) {
			if (existing[i]) existing[i].style.left = `${spots[i]}px`;
			else colonnade.appendChild(column(spots[i]));
		}
		course.style.left = `${spots[Math.min(columns, spots.length - 1)]}px`;
		const left = spots.length - columns;
		course.setAttribute(
			"aria-label",
			`Lay a brick. ${columns} of ${spots.length} columns built; ${PER - loose} more ${PER - loose === 1 ? "brick" : "bricks"} to the next.`,
		);
		course.title = left > 0 ? "Click to add a brick" : "";
	}

	const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

	let busy = false;
	course.addEventListener("click", async () => {
		if (busy) return;
		busy = true;
		count += 1;
		save(count);
		const loose = count % PER;

		if (loose !== 0) {
			slots[loose - 1].classList.add("laid", "landing");
			setTimeout(() => slots[loose - 1].classList.remove("landing"), 400);
			render();
			busy = false;
			return;
		}

		// Fifth brick: set it, turn the course to marble, raise the column,
		// then let the empty outline step on to the next spot.
		slots[PER - 1].classList.add("laid", "landing");
		await wait(350);
		course.classList.add("marbling");
		await wait(450);
		const before = colonnade.children.length;
		render();
		(colonnade.children[before] as HTMLElement | undefined)?.classList.add("rising");
		course.classList.remove("marbling");
		slots.forEach((s) => s.classList.remove("landing"));

		// Every spot filled: admire it for a moment, then start again.
		if (count / PER >= spots.length) {
			course.classList.add("resting");
			await wait(1800);
			colonnade.classList.add("clearing");
			await wait(900);
			count = 0;
			save(count);
			colonnade.replaceChildren();
			colonnade.classList.remove("clearing");
			course.classList.remove("resting");
			render();
		}
		busy = false;
	});

	function layout() {
		measure();
		// A narrower window can leave more columns than spots: start over.
		if (spots.length && Math.floor(count / PER) >= spots.length) {
			count = count % PER;
			save(count);
		}
		render();
	}
	window.addEventListener("resize", layout);
	layout();
</script>

<style>
	.colonnade,
	.course {
		--brick: #a9502c;
		--brick-edge: #7d3a1f;
		--marble: #f7f4ee;
		--marble-shade: #a9a194;
		--col-w: 2.6rem;
		--col-gap: 0.55rem;
		--bottom: 1.25rem;
		--edge: 1;
	}

	/* Columns sit behind the page content; the outline sits above it. */
	.colonnade {
		position: fixed;
		inset: auto 0 var(--bottom) 0;
		z-index: 1;
		height: 0;
		pointer-events: none;
		transition: opacity 0.9s ease;
	}
	.colonnade[hidden],
	.course[hidden] {
		display: none;
	}
	.colonnade:global(.clearing) {
		opacity: 0;
	}
	.colonnade :global(.column) {
		position: absolute;
		bottom: 0;
		/* centred in a spot as wide as the brick outline */
		margin-left: calc(var(--col-w) * 0.075);
		display: flex;
		flex-direction: column;
		align-items: center;
		width: var(--col-w);
		height: 55vh;
		transform-origin: bottom;
		/* solid in the bottom quarter of the screen, fading out above it */
		-webkit-mask-image: linear-gradient(
			to top,
			#000 0,
			#000 calc(25vh - var(--bottom)),
			transparent 100%
		);
		mask-image: linear-gradient(to top, #000 0, #000 calc(25vh - var(--bottom)), transparent 100%);
		filter: drop-shadow(2px 2px 0 color-mix(in oklab, var(--ink) 18%, transparent));
	}
	.colonnade :global(.column.rising) {
		animation: rise 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	@keyframes rise {
		from {
			transform: scaleY(0.12);
			filter: brightness(1.25);
		}
	}
	.colonnade :global(.capital),
	.colonnade :global(.base) {
		flex: none;
		width: 100%;
		height: 0.55rem;
		border: 1px solid var(--marble-shade);
		border-radius: 1px;
		background: var(--marble);
	}
	.colonnade :global(.capital) {
		width: 118%;
		box-shadow: 0 0.3rem 0 -0.1rem var(--marble-shade);
	}
	.colonnade :global(.base) {
		width: 118%;
	}
	.colonnade :global(.shaft) {
		flex: 1;
		width: 84%;
		border-inline: 1px solid var(--marble-shade);
		/* fluting */
		background:
			repeating-linear-gradient(
				90deg,
				transparent 0 18%,
				color-mix(in oklab, var(--marble-shade) 55%, transparent) 18% 23%
			),
			linear-gradient(90deg, #fff 0%, var(--marble) 30%, #cfc8bb 100%);
	}

	.course {
		position: fixed;
		bottom: var(--bottom);
		z-index: 40;
		display: flex;
		flex-direction: column-reverse;
		gap: 2px;
		width: calc(var(--col-w) * 1.15);
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		transition:
			left 0.6s cubic-bezier(0.3, 0.9, 0.3, 1),
			opacity 0.4s;
	}
	.course.resting {
		opacity: 0.3;
		pointer-events: none;
	}
	.slot {
		display: block;
		height: 0.7rem;
		border: 1.5px dashed color-mix(in oklab, var(--ink) 45%, transparent);
		border-radius: 2px;
		margin-inline: 0.35rem 0;
		transition:
			background-color 0.3s,
			border-color 0.3s;
	}
	.slot:nth-child(even) {
		margin-inline: 0 0.35rem;
	}
	.course:hover .slot:not(.laid),
	.course:focus-visible .slot:not(.laid) {
		border-color: var(--accent);
	}
	.slot.laid {
		border: 1px solid var(--brick-edge);
		background:
			linear-gradient(90deg, transparent 48%, rgb(0 0 0 / 0.2) 48% 52%, transparent 52%),
			var(--brick);
	}
	.slot.landing {
		animation: drop 0.35s cubic-bezier(0.5, 0, 0.6, 1.6);
	}
	@keyframes drop {
		from {
			transform: translateY(-1.6rem);
			opacity: 0;
		}
	}
	.course.marbling .slot {
		border-color: var(--marble-shade);
		background: var(--marble);
		margin-inline: 0;
	}

	@media (max-width: 900px) {
		.colonnade,
		.course {
			--col-w: 1.9rem;
			--col-gap: 0.4rem;
			--edge: 0.5;
		}
		.slot {
			height: 0.55rem;
		}
	}
</style>
