---
import type { RouteName } from "@/consts";

// Hand-drawn icons for the five categories, drawn loose on purpose and
// stroked in currentColor so they follow the palette.
type DoodleName = RouteName | "about" | "menu";

interface Props {
	name: DoodleName;
	class?: string;
}

const { name, class: className = "" } = Astro.props;

const paths: Record<DoodleName, string[]> = {
	// briefcase
	work: [
		"M9 19.5c4-.6 26-.9 30 .3.8 5 .6 14-.3 18.6-6.2.9-24 .8-29.3-.2-.9-5.2-1.1-13.4-.4-18.7z",
