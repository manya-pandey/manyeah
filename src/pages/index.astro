---
import About from "@/components/About.astro";
import DoodleNav from "@/components/DoodleNav.astro";
import Loader from "@/components/Loader.astro";
import Statue from "@/components/Statue.astro";
import { SITE, STATUE } from "@/consts";
import { getWhoami } from "@/lib/whoami";
import Base from "@/layouts/Base.astro";

const me = await getWhoami();
---

<Base>
	<Loader />
	<Statue />

	<header class="top" data-top>
		<div class="top-inner">
			<DoodleNav />
		</div>
		<!--
			Once the visitor reaches the end, a box slides out of the pinned bar
			with an arrow up at "work". It belongs to the bar (the bar grows to
			make room for it), so it never lies on top of the page text.
		-->
		<div class="end-hint" data-end-hint aria-live="polite">
			<div class="hint-inner">
				<svg viewBox="0 0 40 40" aria-hidden="true">
					<path d="M30 34C18 32 10 24 10 6" />
					<path d="M3.5 12.5c2.4-2.8 4.6-5.6 6.6-8.6 2 3 4 5.8 6.4 8.4" />
				</svg>
				<p>Start with work up here, then explore the rest.</p>
			</div>
		</div>
	</header>

	<main>
		<div class="landing">
			<div class="hero">
				<h1 class="name">{me.name}</h1>
				<p class="intro">{me.intro}</p>
				<a class="resume" href={SITE.RESUME}>
					résumé
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18.5 5.5M9 5h10v10" /></svg>
				</a>
			</div>

			<div class="bottom">
				{
					STATUE.CREDIT_URL ? (
						<a class="credit" href={STATUE.CREDIT_URL} rel="noopener">
							statue: {STATUE.CREDIT}
						</a>
					) : (
						<span class="credit">statue: {STATUE.CREDIT}</span>
					)
				}
				<div class="actions">
					<a class="box" href="#whoami">
						<span>scroll</span>
						<svg class="arrow-down" viewBox="0 0 24 32" aria-hidden="true">
							<path d="M12.2 3.5c-.4 7.8-.3 15.6.1 23.6M4.6 19.4c2.6 2.6 5 5.2 7.6 8.1 2.4-2.9 4.8-5.6 7.4-8" />
						</svg>
					</a>
					<a class="box" href="#contact" data-contact-open>
						<svg class="envelope" viewBox="0 0 32 24" aria-hidden="true">
							<path d="M3.4 4.2c8.6-.6 17-.7 25.4-.1.6 5.4.5 10.8-.1 16.2-8.4.6-16.8.6-25.2 0-.6-5.4-.7-10.8-.1-16.1z" />
							<path d="M3.8 4.8c4 3.4 8 6.4 12.2 9.2 4.2-2.8 8.2-5.8 12.4-9.4" />
						</svg>
						<span>contact</span>
					</a>
				</div>
			</div>
		</div>

		<About />
	</main>

</Base>

<script>
	const top = document.querySelector<HTMLElement>("[data-top]")!;
	const hint = document.querySelector<HTMLElement>("[data-end-hint]")!;
	const work = document.querySelector<HTMLElement>('[data-route="work"]')!;
	// Line the arrow's tip (10px into the hint) up under the middle of "work".
	function placeHint() {
		const r = work.getBoundingClientRect();
		const strip = hint.getBoundingClientRect();
		hint.style.setProperty("--hint-x", `${Math.max(0, r.left + r.width / 2 - strip.left - 10)}px`);
	}
	function onScroll() {
		top.classList.toggle("is-stuck", window.scrollY > 12);
		const fromEnd = document.documentElement.scrollHeight - (window.innerHeight + window.scrollY);
		const shown = hint.classList.contains("is-shown");
		// Opening the strip makes the page a little taller; the wider margin for
		// closing stops it flickering open and shut at the boundary.
		const atEnd = window.scrollY > 40 && fromEnd <= (shown ? 220 : 60);
		if (atEnd && !shown) {
			placeHint();
			// and again once the pinned nav has finished shrinking
			setTimeout(placeHint, 260);
		}
		hint.classList.toggle("is-shown", atEnd);
	}
	window.addEventListener("resize", placeHint);
	window.addEventListener("scroll", onScroll, { passive: true });
	window.addEventListener("resize", onScroll);
	onScroll();
</script>

<style>
	/* The nav stays pinned to the top and tightens up once the page scrolls. */
	.top {
		position: sticky;
		top: 0;
		z-index: 30;
		padding: clamp(1rem, 3vw, 2.25rem) clamp(1rem, 4vw, 3.5rem) 0.5rem;
		transition:
			padding 0.25s ease,
			background-color 0.25s ease,
			box-shadow 0.25s ease;
	}
	.top-inner {
		display: flex;
		align-items: flex-start;
		gap: 1.5rem;
		max-width: 68rem;
		margin-inline: auto;
	}
	.top-inner :global(.doodle-nav) {
		flex: 1;
		min-width: 0;
	}
	.top.is-stuck {
		padding-top: 0.6rem;
		padding-bottom: 0.4rem;
		background: var(--bg);
		box-shadow: 0 1.5px 0 var(--line);
	}
	/* the pinned bar carries the same texture as the page behind it */
	.top.is-stuck::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		opacity: var(--texture-opacity);
		background: url("/background.png") repeat;
		background-size: 200px 200px;
		pointer-events: none;
	}
	.top.is-stuck :global(.doodle-nav .icon) {
		width: 2rem;
		height: 2rem;
	}
	.top.is-stuck :global(.doodle-nav .bracket) {
		height: 2.4rem;
	}
	.top.is-stuck :global(.doodle-nav a),
	.top.is-stuck :global(.doodle-nav button) {
		font-size: 0.95rem;
	}
	.top :global(.doodle-nav .icon),
	.top :global(.doodle-nav .bracket),
	.top :global(.doodle-nav a),
	.top :global(.doodle-nav button) {
		transition: all 0.25s ease;
	}

	.landing {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-rows: 1fr auto;
		/* the first screen, under the header */
		min-height: calc(100dvh - 8.5rem);
		padding: 1rem clamp(1rem, 4vw, 3.5rem) clamp(1rem, 3vw, 2.25rem);
		gap: 1rem;
	}

	.hero {
		align-self: center;
		max-width: 34rem;
		padding-left: clamp(0rem, 6vw, 7rem);
	}
	.name {
		font-size: clamp(3rem, 9vw, 6.5rem);
		line-height: 0.95;
		letter-spacing: 0.04em;
	}
	.intro {
		margin-top: 1rem;
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		line-height: 1.4;
		color: var(--ink);
		max-width: 26rem;
	}
	.tagline {
		margin-top: 0.4rem;
		color: var(--muted);
	}
	.resume {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 1.4rem;
		padding-bottom: 0.1rem;
		border-bottom: 1.5px solid var(--accent);
		color: var(--accent);
		font-size: 0.95rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
	}
	.resume svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		transition: transform 0.2s ease;
	}
	.resume:hover svg {
		transform: translate(2px, -2px);
	}

	.bottom {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: end;
		gap: 1rem;
	}
	.credit {
		justify-self: start;
		font-size: 0.8rem;
		color: var(--muted);
		opacity: 0.7;
		text-decoration: none;
	}
	.credit:hover {
		opacity: 1;
		text-decoration: underline;
	}

	/* Scroll and contact boxes, bottom centre. */
	.actions {
		display: flex;
		gap: 0.9rem;
		margin-bottom: 1.4rem;
	}
	.box {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.5rem 0.95rem;
		border: 1.5px solid var(--ink);
		border-radius: 3px 6px 4px 7px / 6px 3px 7px 4px;
		background: color-mix(in oklab, var(--bg) 85%, transparent);
		box-shadow: 3px 3px 0 var(--ink);
		color: var(--ink);
		font-size: 1.05rem;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition:
			transform 0.12s ease,
			box-shadow 0.12s ease,
			color 0.15s;
	}
	.box:hover {
		transform: translate(-1px, -1px);
		box-shadow: 4px 4px 0 var(--accent);
		color: var(--accent);
	}
	.box:active {
		transform: translate(2px, 2px);
		box-shadow: 1px 1px 0 var(--ink);
	}
	.box svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.arrow-down {
		width: 1rem;
		height: 1.4rem;
		animation: nudge 1.6s ease-in-out infinite;
	}
	.envelope {
		width: 1.6rem;
		height: 1.2rem;
	}
	@keyframes nudge {
		0%,
		100% {
			transform: translateY(-2px);
		}
		50% {
			transform: translateY(4px);
		}
	}

	/* The end-of-page hint under the pinned bar, arrow up at "work". */
	.end-hint {
		display: grid;
		grid-template-rows: 0fr;
		max-width: 68rem;
		margin-inline: auto;
		color: var(--accent);
		transition: grid-template-rows 0.35s ease;
	}
	.end-hint.is-shown {
		grid-template-rows: 1fr;
	}
	.hint-inner {
		display: flex;
		align-items: flex-start;
		gap: 0.3rem;
		min-height: 0;
		overflow: hidden;
		padding-left: var(--hint-x, 0);
		/* room for the box's offset shadow */
		padding-bottom: 0.6rem;
		opacity: 0;
		transform: translateY(-6px);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}
	.end-hint.is-shown .hint-inner {
		opacity: 1;
		transform: none;
		transition-delay: 0.12s;
	}
	.end-hint svg {
		flex: none;
		width: 1.9rem;
		height: 2.3rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.end-hint p {
		margin-top: 0.9rem;
		max-width: 16rem;
		padding: 0.45rem 0.8rem 0.5rem;
		border: 1.5px solid currentColor;
		border-radius: 4px 9px 5px 8px / 9px 4px 8px 5px;
		background: var(--bg);
		box-shadow: 3px 3px 0 var(--line);
		font-size: 1.05rem;
		line-height: 1.2;
		text-wrap: balance;
	}

	@media (max-width: 720px) {
		.hero {
			padding-left: 0;
		}
		.bottom {
			grid-template-columns: 1fr;
			justify-items: start;
		}
		.actions {
			margin-bottom: 0;
		}
	}
	@media (max-width: 640px) {
		.top-inner {
			gap: 0.4rem;
		}
		/* phones keep the nav at its already-small size when pinned */
		.top.is-stuck :global(.doodle-nav a),
		.top.is-stuck :global(.doodle-nav button) {
			font-size: 0.72rem;
		}
		.top.is-stuck :global(.doodle-nav .icon) {
			width: 1.9rem;
			height: 1.9rem;
		}
		.top.is-stuck :global(.doodle-nav .bracket) {
			height: 2.3rem;
		}
	}
</style>
