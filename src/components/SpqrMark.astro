---
// The SPQR mark in the site's own hand: SPQR in Bree Serif between the same
// hand-drawn square brackets as the nav doodles. Colours come from the theme.
// SPQR here stands for Scientia Per Quaestionem Reperitur, "knowledge is
// found through questioning".
interface Props {
	class?: string;
	animated?: boolean;
}

const { class: className = "", animated = false } = Astro.props;
const letters = ["S", "P", "Q", "R"];
---

<svg
	class:list={["spqr", { "spqr--animated": animated }, className]}
	viewBox="0 0 220 84"
	role="img"
	aria-label="SPQR"
>
	<g class="brackets" fill="none" stroke-linecap="round" stroke-linejoin="round">
		<path pathLength="1" d="M27 6.5c-6.4.4-11.8.2-15.6 1.4-1.3 22.6-1.1 45.4.4 68.2 3.8.9 9.3.9 15 1.4" />
		<path pathLength="1" d="M193 6.5c6.4.4 11.8.2 15.6 1.4 1.3 22.6 1.1 45.4-.4 68.2-3.8.9-9.3.9-15 1.4" />
	</g>
	<text class="word" x="110" y="57" text-anchor="middle">
		{letters.map((l, i) => <tspan style={`--i: ${i}`}>{l}</tspan>)}
	</text>
</svg>

<style>
	.spqr {
		overflow: visible;
		color: var(--ink);
	}
	.brackets {
		stroke: var(--accent);
		stroke-width: 3.2;
	}
	.word {
		fill: currentColor;
		font-family: var(--font-main);
		font-size: 44px;
		letter-spacing: 0.12em;
	}

	/* Load sequence: the brackets are drawn, then the letters set one by one. */
	.spqr--animated .brackets path {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: draw 0.8s cubic-bezier(0.6, 0, 0.3, 1) forwards;
	}
	.spqr--animated .brackets path:last-child {
		animation-delay: 0.15s;
	}
	/* tspans take fill-opacity, not opacity */
	.spqr--animated .word tspan {
		fill-opacity: 0;
		animation: set 0.35s ease-out forwards;
		animation-delay: calc(0.7s + var(--i) * 0.12s);
	}
	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes set {
		to {
			fill-opacity: 1;
		}
	}
</style>
