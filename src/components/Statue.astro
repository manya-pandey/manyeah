---
import { STATUE } from "@/consts";
---

<!-- The floating statue behind the landing page. Rendering approach adapted from LHRUN/one-space (MIT). -->
<div id="statue" class="statue" data-src={STATUE.SRC} data-draco="/draco/" data-turn={STATUE.TURN} aria-hidden="true"></div>

<script>
	import * as THREE from "three";
	import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
	import { DRACOLoader } from "three/addons/loaders/DRACOLoader.js";

	const container = document.getElementById("statue")!;
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const ready = () => window.dispatchEvent(new Event("statue:ready"));

	const cssVar = (name: string) =>
		getComputedStyle(document.documentElement).getPropertyValue(name).trim();
	const cssColor = (name: string) => new THREE.Color(cssVar(name) || "#ffffff");
	const cssNumber = (name: string, fallback: number) => Number(cssVar(name)) || fallback;

	// Some hosts' content policies forbid compiling WebAssembly; Draco then
	// falls back to its (slower, larger) plain-JavaScript decoder.
	async function wasmAllowed() {
		try {
			await WebAssembly.compile(new Uint8Array([0, 0x61, 0x73, 0x6d, 1, 0, 0, 0]));
			return true;
		} catch {
			return false;
		}
	}

	// Fetch the bytes ourselves and parse them, rather than handing the URL
	// to GLTFLoader. A .json source is a { "glb": "<base64>" } wrapper, for
	// hosts that won't serve .glb files.
	async function loadStatue(src: string, dracoPath: string) {
		const res = await fetch(src);
		if (!res.ok) throw new Error(`${src}: HTTP ${res.status}`);
		let bytes: ArrayBuffer;
		if (src.endsWith(".json")) {
			const { glb } = (await res.json()) as { glb: string };
			bytes = Uint8Array.from(atob(glb), (c) => c.charCodeAt(0)).buffer;
		} else {
			bytes = await res.arrayBuffer();
		}
		const draco = new DRACOLoader().setDecoderPath(dracoPath);
		// setDecoderConfig() is deprecated (and untyped here); the property it
		// set is what the loader reads.
		if (!(await wasmAllowed())) {
			(draco as unknown as { decoderConfig: { type?: string } }).decoderConfig.type = "js";
		}
		try {
			return await new GLTFLoader().setDRACOLoader(draco).parseAsync(bytes, "");
		} finally {
			draco.dispose();
		}
	}

	function start() {
		let renderer: THREE.WebGLRenderer;
		try {
			renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
		} catch {
			// No WebGL: the page still works, there's just no statue.
			ready();
			return;
		}
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		renderer.setSize(window.innerWidth, window.innerHeight);
		container.appendChild(renderer.domElement);

		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(
			40,
			window.innerWidth / window.innerHeight,
			0.1,
			100,
		);
		camera.position.set(0, 0, 6);

		const ambient = new THREE.AmbientLight(0xffffff, cssNumber("--statue-ambient", 0.25));
		// A soft key light off to one side. It follows the pointer slowly and
		// within a small range, so it grazes the bust instead of flooding it.
		const key = new THREE.PointLight(cssColor("--statue-light"), 20, 0, 1.6);
		key.position.set(2, 1.5, 2.4);
		const rim = new THREE.DirectionalLight(cssColor("--accent"), 1.4);
		rim.position.set(-3, 2, -2);
		scene.add(ambient, key, rim);

		// Recolour the lights whenever the palette changes.
		new MutationObserver(() => {
			key.color = cssColor("--statue-light");
			rim.color = cssColor("--accent");
			ambient.intensity = cssNumber("--statue-ambient", 0.25);
		}).observe(document.documentElement, { attributes: true, attributeFilter: ["data-palette", "style"] });

		const baseY = Number(container.dataset.turn) || 0;
		const pivot = new THREE.Group();
		scene.add(pivot);

		loadStatue(container.dataset.src!, container.dataset.draco!)
			.then((gltf) => {
				const model = gltf.scene;
				const marble = new THREE.MeshStandardMaterial({
					color: 0xf3efe7,
					roughness: 0.55,
					metalness: 0.05,
				});
				model.traverse((obj) => {
					if ((obj as THREE.Mesh).isMesh) (obj as THREE.Mesh).material = marble;
				});

				// Centre and normalise so any bust swapped in sits the same way.
				const box = new THREE.Box3().setFromObject(model);
				const size = box.getSize(new THREE.Vector3());
				const centre = box.getCenter(new THREE.Vector3());
				model.position.sub(centre);
				const scale = 2.7 / Math.max(size.x, size.y, size.z);
				pivot.scale.setScalar(scale);
				pivot.add(model);
				pivot.rotation.y = baseY;

				container.classList.add("statue--in");
			})
			.catch((error) => console.warn("Statue failed to load:", error))
			.finally(ready);

		// Light follows the pointer; the bust leans a touch toward it.
		const target = { x: 0, y: 0 };
		const onMove = (x: number, y: number) => {
			target.x = (x / window.innerWidth) * 2 - 1;
			target.y = -((y / window.innerHeight) * 2 - 1);
		};
		window.addEventListener("pointermove", (e) => onMove(e.clientX, e.clientY), { passive: true });

		// Where the bust sits: right of the name on wide screens, above it on phones.
		const anchor = new THREE.Vector2();
		const onResize = () => {
			camera.aspect = window.innerWidth / window.innerHeight;
			const narrow = camera.aspect < 0.8;
			camera.position.z = narrow ? (6 / Math.max(camera.aspect, 0.5)) * 0.8 : 6;
			anchor.set(narrow ? 0 : Math.min(camera.aspect - 1, 0.9), narrow ? 0.9 : 0);
			camera.updateProjectionMatrix();
			renderer.setSize(window.innerWidth, window.innerHeight);
		};
		window.addEventListener("resize", onResize);
		onResize();

		let visible = true;
		document.addEventListener("visibilitychange", () => {
			visible = document.visibilityState === "visible";
			if (visible) requestAnimationFrame(tick);
		});

		// Scrolling rolls the bust a full turn on two axes, as on LHRUN/one-space.
		let roll = 0;
		const scrollFraction = () => {
			const max = document.documentElement.scrollHeight - window.innerHeight;
			return max > 0 ? window.scrollY / max : 0;
		};

		// As the whoami section scrolls in, the bust glides from beside the name
		// to the middle of the screen (eased, so it settles rather than stops)
		// and fades to about a third of its strength.
		const about = document.getElementById("whoami");
		let centred = 0;
		const centreTarget = () => {
			if (!about) return 0;
			const travel = about.offsetTop - window.innerHeight * 0.35;
			const p = Math.min(1, Math.max(0, window.scrollY / Math.max(travel, 1)));
			return p * p * (3 - 2 * p);
		};

		const startedAt = performance.now();
		function tick() {
			if (!visible) return;
			const t = (performance.now() - startedAt) / 1000;
			key.position.x += (1.2 + target.x * 1.6 - key.position.x) * 0.03;
			// Keep the light at or above eye level; lit from below, the bust turns ghoulish.
			key.position.y += (Math.max(target.y * 1.5, -0.2) + 1 - key.position.y) * 0.03;
			centred += (centreTarget() - centred) * (reduceMotion ? 1 : 0.08);
			const restX = anchor.x * (1 - centred);
			const restY = anchor.y * (1 - centred);
			// ...and fades back so the whoami text in front of it reads clearly.
			renderer.domElement.style.opacity = String(1 - 0.65 * centred);
			pivot.position.x = restX;
			if (reduceMotion) {
				pivot.position.y = restY;
			} else {
				roll += (scrollFraction() * Math.PI * 2 - roll) * 0.08;
				pivot.position.y = restY + Math.sin(t * 0.6) * 0.12;
				pivot.rotation.y = baseY + roll + Math.sin(t * 0.25) * 0.12 + target.x * 0.12;
				pivot.rotation.x = roll + Math.sin(t * 0.4) * 0.03 - target.y * 0.05;
			}
			renderer.render(scene, camera);
			requestAnimationFrame(tick);
		}
		requestAnimationFrame(tick);
	}

	start();
</script>

<style>
	.statue {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 1.6s ease;
	}
	.statue:global(.statue--in) {
		opacity: var(--statue-opacity);
	}
</style>
