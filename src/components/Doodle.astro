		"M9.5 27.5c6.8 1.8 22.4 1.9 29-.2",
		"M22 26.6c-.2 1.3 0 2.6.3 3.3 1.2.3 2.6.3 3.6-.1.3-.9.3-2.2.1-3.3",
	],
	// magnifier over a page of notes
	research: [
		"M12 10.5c5.5-.6 13.5-.7 18.2.1.5 7.3.4 19.9-.3 27.4-5.4.6-13.4.6-18 0-.6-7.8-.7-20.3.1-27.5z",
