---
import SpqrMark from "./SpqrMark.astro";
---

<!--
	Loading screen. Shown once per browser session on the landing page; it
	lifts when the statue has loaded (or after a timeout, so it never traps
	anyone behind a slow connection).
-->
<div id="loader" class="loader" aria-hidden="true">
	<SpqrMark animated class="w-[min(520px,82vw)]" />
	<p class="loader-status font-mono">laying foundations<span class="cursor">_</span></p>
</div>

<script is:inline>
	(() => {
		const loader = document.getElementById("loader");
		if (!loader) return;
		let seen = false;
		try {
			seen = sessionStorage.getItem("spqr-seen") === "1";
			sessionStorage.setItem("spqr-seen", "1");
		} catch {}
		if (seen) {
			loader.remove();
			return;
		}
		const shownAt = performance.now();
		const MIN_MS = 1900;
		const MAX_MS = 5000;
		let done = false;
		const lift = () => {
			if (done) return;
			done = true;
			const wait = Math.max(0, MIN_MS - (performance.now() - shownAt));
			setTimeout(() => {
				loader.classList.add("loader--out");
				loader.addEventListener("transitionend", () => loader.remove(), { once: true });
				setTimeout(() => loader.remove(), 900);
			}, wait);
		};
		window.addEventListener("statue:ready", lift, { once: true });
		setTimeout(lift, MAX_MS);
	})();
</script>

<style>
	.loader {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2rem;
		background: #070908;
		transition:
			opacity 0.6s ease,
			visibility 0.6s;
	}
	.loader--out {
		opacity: 0;
		visibility: hidden;
	}
	.loader-status {
		color: #3cf2a0;
		opacity: 0.55;
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}
	.cursor {
		animation: blink 1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
</style>
