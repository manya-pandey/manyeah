---
import SpqrMark from "@/components/SpqrMark.astro";
import { MOTTO } from "@/consts";
import Base from "@/layouts/Base.astro";
---

<Base title="Not found">
	<main class="relative z-2 flex min-h-dvh flex-col items-center justify-center gap-5 p-6 text-center">
		<SpqrMark animated class="w-[min(300px,70vw)]" />
		<p class="text-xl">404 · this road doesn't lead to Rome.</p>
		<p class="text-muted">{MOTTO.LATIN}, but not here.</p>
		<a href="/" class="text-accent underline underline-offset-4">take me back</a>
	</main>
</Base>
