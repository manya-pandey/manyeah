---
import { fullDate } from "@/lib/format";
import Section from "@/layouts/Section.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("blogs", ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Section section="blogs" title={post.data.title} description={post.data.description}>
	<time class="date" datetime={post.data.date.toISOString()}>{fullDate(post.data.date)}</time>
	<article class="prose">
		<Content />
	</article>
</Section>

<style>
	.date {
		display: block;
		margin: -1.8rem 0 2rem;
		color: var(--muted);
		font-style: italic;
	}
	.prose {
		font-size: 1.2rem;
		line-height: 1.65;
	}
</style>
