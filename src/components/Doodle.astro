		"M35.4 37c1.8 1.7 3.6 3.6 5 5.4",
	],
	// two little people, leaning in
	people: [
		"M16.6 12.4c2.4-.2 4.3 1.6 4.3 3.9 0 2.4-1.9 4.2-4.2 4.2-2.4 0-4.2-1.9-4.2-4.1 0-2.2 1.8-3.9 4.1-4z",
		"M8.8 36.5c-.3-6.4 2.9-12 7.9-12.1 4.4 0 7.4 4.5 7.6 10.4",
		"M31.4 15.4c2.4-.1 4.2 1.8 4.2 4.1s-1.9 4.1-4.2 4.1c-2.3 0-4.1-1.9-4.1-4.1 0-2.2 1.9-4.1 4.1-4.1z",
		"M23.9 37.8c-.1-5.8 3-10.5 7.6-10.6 4.7-.1 7.6 4.7 7.6 10.8",
