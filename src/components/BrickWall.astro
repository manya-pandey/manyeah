---
import { BRICKS_PER_MARBLE } from "@/consts";

const slots = Array.from({ length: BRICKS_PER_MARBLE });
---

<!--
	"Add a brick". Every visitor can lay one; every five stacked bricks turn
	to marble and the rest stay brick. The count lives in Cloudflare KV
	(/api/bricks); if that isn't reachable, it falls back to this browser.
-->
<section class="bricks" data-per-marble={BRICKS_PER_MARBLE} aria-label="Add a brick">
	<div class="lay">
		<button type="button" class="lay-button" data-lay>
			<span class="lay-text">Click to add a brick</span>
			<svg class="lay-arrow" viewBox="0 0 64 20" aria-hidden="true">
				<path d="M2 11c12-2.4 30-3.2 52-1.6M46 3.5c3.4 2.4 7 4.4 10.2 6.3-3.5 1.8-6.8 4-9.6 6.8" />
			</svg>
			<span class="lay-brick" aria-hidden="true"></span>
		</button>
		<button
			type="button"
			class="why"
			data-why
			aria-expanded="false"
			aria-controls="why-pop"
			aria-label="Why bricks?">?</button
		>
		<div id="why-pop" class="why-pop" role="note" hidden>
			<p>
				<span class="note">When {BRICKS_PER_MARBLE} bricks are stacked, they become marble.</span>
			</p>
			<p>
				Augustus is said to have found Rome a city of brick and left it a city of marble. This site
				is my small city, and every visitor gets to lay a brick. Lay enough together and they turn
				to marble. Thanks for helping build it.
			</p>
			<p class="mine" data-mine hidden></p>
			<p class="local" data-local hidden>
				(The shared count is offline right now, so these bricks are only in your browser.)
			</p>
		</div>
	</div>

	<figure class="column" aria-describedby="brick-count">
		<div class="marble-stack" data-marble-stack>
			<span class="more" data-more hidden></span>
			<span class="marble-ghost" data-ghost>marble</span>
		</div>
		<div class="brick-slots" data-slots>
			{slots.map(() => <span class="slot" />)}
		</div>
		<figcaption id="brick-count" class="count" aria-live="polite" data-count>&nbsp;</figcaption>
	</figure>
</section>

<script>
	const root = document.querySelector<HTMLElement>(".bricks")!;
	const PER = Number(root.dataset.perMarble);
	const MAX_MARBLE_SHOWN = 7;
	const LOCAL_KEY = "bricks-local";
	const MINE_KEY = "bricks-mine";

	const slots = [...root.querySelectorAll<HTMLElement>(".slot")];
	const marbleStack = root.querySelector<HTMLElement>("[data-marble-stack]")!;
	const more = root.querySelector<HTMLElement>("[data-more]")!;
	const ghost = root.querySelector<HTMLElement>("[data-ghost]")!;
	const countEl = root.querySelector<HTMLElement>("[data-count]")!;
	const layButton = root.querySelector<HTMLButtonElement>("[data-lay]")!;
	const why = root.querySelector<HTMLButtonElement>("[data-why]")!;
	const pop = root.querySelector<HTMLElement>("#why-pop")!;
	const mineEl = root.querySelector<HTMLElement>("[data-mine]")!;
	const localEl = root.querySelector<HTMLElement>("[data-local]")!;

	let count = 0;
	let shared = true;

	const store = {
		get(key: string) {
			try {
				return Number(localStorage.getItem(key) ?? 0) || 0;
			} catch {
				return 0;
			}
		},
		set(key: string, value: number) {
			try {
				localStorage.setItem(key, String(value));
			} catch {}
		},
	};

	let limited = false;
	async function api(method: "GET" | "POST"): Promise<number | null> {
		try {
			const res = await fetch("/api/bricks", { method });
			if (!res.headers.get("content-type")?.includes("application/json")) return null;
			const data = (await res.json()) as { count?: number };
			limited = res.status === 429;
			return typeof data.count === "number" ? data.count : null;
		} catch {
			return null;
		}
	}

	function marbleBlock() {
		const block = document.createElement("span");
		block.className = "marble";
		// Every block gets its own veins.
		block.style.setProperty("--vein-a", `${Math.round(Math.random() * 360)}deg`);
		block.style.setProperty("--vein-x", `${Math.round(Math.random() * 100)}%`);
		return block;
	}

	function render() {
		const loose = count % PER;
		const marble = Math.floor(count / PER);
		slots.forEach((slot, i) => slot.classList.toggle("filled", i < loose));

		const shown = Math.min(marble, MAX_MARBLE_SHOWN);
		const blocks = marbleStack.querySelectorAll(".marble");
		for (let i = blocks.length; i < shown; i++) marbleStack.appendChild(marbleBlock());
		for (let i = shown; i < blocks.length; i++) blocks[i].remove();
		ghost.hidden = marble > 0;
		more.hidden = marble <= MAX_MARBLE_SHOWN;
		more.textContent = `+${marble - MAX_MARBLE_SHOWN}`;

		countEl.textContent = `${count} ${count === 1 ? "brick" : "bricks"} laid · ${marble} in marble`;
		const mine = store.get(MINE_KEY);
		mineEl.hidden = mine === 0;
		mineEl.textContent = `You've laid ${mine} ${mine === 1 ? "brick" : "bricks"} so far.`;
		localEl.hidden = shared;
	}

	async function load() {
		const remote = await api("GET");
		if (remote === null) {
			shared = false;
			count = store.get(LOCAL_KEY);
		} else {
			count = remote;
		}
		render();
	}

	let busy = false;
	layButton.addEventListener("click", async () => {
		if (busy) return;
		busy = true;
		layButton.classList.add("pressed");

		const remote = shared ? await api("POST") : null;
		if (remote === null) {
			shared = false;
			count = store.get(LOCAL_KEY) + 1;
			store.set(LOCAL_KEY, count);
		} else {
			count = remote;
		}
		if (limited) {
			render();
			countEl.textContent = "the mortar's still setting, try again in a minute";
			layButton.classList.remove("pressed");
			busy = false;
			return;
		}
		store.set(MINE_KEY, store.get(MINE_KEY) + 1);

		// Show the brick landing, then (if it was the fifth) the turn to marble.
		const loose = count % PER;
		const landed = loose === 0 ? slots[PER - 1] : slots[loose - 1];
		landed.classList.add("filled", "landing");
		if (loose === 0) {
			slots.forEach((s) => s.classList.add("filled"));
			await new Promise((r) => setTimeout(r, 380));
			root.classList.add("marbling");
			await new Promise((r) => setTimeout(r, 650));
			root.classList.remove("marbling");
		} else {
			await new Promise((r) => setTimeout(r, 380));
		}
		landed.classList.remove("landing");
		render();
		const newest = marbleStack.querySelector(".marble:last-of-type");
		if (loose === 0 && newest) newest.classList.add("fresh");

		layButton.classList.remove("pressed");
		busy = false;
	});

	why.addEventListener("click", () => {
		const open = pop.hidden;
		pop.hidden = !open;
		why.setAttribute("aria-expanded", String(open));
	});
	document.addEventListener("click", (e) => {
		if (!pop.hidden && !root.querySelector(".lay")!.contains(e.target as Node)) {
			pop.hidden = true;
			why.setAttribute("aria-expanded", "false");
		}
	});
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && !pop.hidden) {
			pop.hidden = true;
			why.setAttribute("aria-expanded", "false");
			why.focus();
		}
	});

	load();
</script>

<style>
	.bricks {
		display: contents;
	}

	/* --- the button, bottom centre --- */
	.lay {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.lay-button {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.5rem 0.9rem;
		border: 1.5px solid var(--ink);
		border-radius: 3px 6px 4px 7px / 6px 3px 7px 4px;
		background: color-mix(in oklab, var(--bg) 80%, transparent);
		backdrop-filter: blur(4px);
		color: var(--ink);
		font-family: var(--font-hand);
		font-size: 1.45rem;
		line-height: 1;
		white-space: nowrap;
		cursor: pointer;
		box-shadow: 3px 3px 0 var(--ink);
		transition:
			transform 0.12s ease,
			box-shadow 0.12s ease;
	}
	.lay-button:hover {
		transform: translate(-1px, -1px);
		box-shadow: 4px 4px 0 var(--accent);
	}
	.lay-button:active,
	.lay-button.pressed {
		transform: translate(2px, 2px);
		box-shadow: 1px 1px 0 var(--ink);
	}
	.lay-arrow {
		width: 2.4rem;
		height: 0.9rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.lay-brick {
		width: 2.6rem;
		height: 0.95rem;
		border: 1.5px dashed var(--ink);
		border-radius: 2px;
		transition: background 0.2s;
	}
	.lay-button:hover .lay-brick {
		background: var(--brick);
		border-style: solid;
		border-color: var(--brick-edge);
	}

	.why {
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 999px;
		border: 1.5px solid var(--muted);
		color: var(--muted);
		font-family: var(--font-hand);
		font-size: 1.1rem;
		line-height: 1;
		cursor: pointer;
		background: transparent;
	}
	.why:hover,
	.why[aria-expanded="true"] {
		color: var(--accent);
		border-color: var(--accent);
	}
	.why-pop {
		position: absolute;
		bottom: calc(100% + 0.9rem);
		left: 50%;
		translate: -50% 0;
		width: min(22rem, calc(100vw - 2rem));
		padding: 0.9rem 1rem;
		border: 1.5px solid var(--ink);
		border-radius: 4px;
		background: var(--bg);
		box-shadow: 4px 4px 0 var(--line);
		font-size: 0.98rem;
		line-height: 1.45;
		z-index: 20;
		animation: rise 0.2s ease-out;
	}
	.why-pop[hidden] {
		display: none;
	}
	.why-pop p + p {
		margin-top: 0.5rem;
	}
	.why-pop .note {
		font-family: var(--font-hand);
		font-size: 1.3rem;
		color: var(--accent);
	}
	.why-pop .mine,
	.why-pop .local {
		color: var(--muted);
		font-style: italic;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	/* --- the column, bottom right: marble above, the brick course below --- */
	.column {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: 6.2rem;
		margin: 0;
	}
	.marble-stack {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 2px;
		min-height: 1.2rem;
		position: relative;
	}
	.more {
		align-self: center;
		font-family: var(--font-hand);
		font-size: 1rem;
		color: var(--muted);
	}
	.more[hidden],
	.marble-ghost[hidden] {
		display: none;
	}
	.marble-ghost {
		display: grid;
		place-items: center;
		height: 2.4rem;
		border: 1px dashed var(--line);
		border-radius: 2px;
		font-family: var(--font-hand);
		font-size: 0.95rem;
		color: var(--muted);
		opacity: 0.8;
	}
	.marble-stack :global(.marble) {
		display: block;
		height: 0.95rem;
		border-radius: 2px;
		border: 1px solid var(--marble-vein);
		background:
			linear-gradient(
				var(--vein-a, 20deg),
				transparent 0 42%,
				color-mix(in oklab, var(--marble-vein) 80%, transparent) 44%,
				transparent 47% 100%
			),
			radial-gradient(circle at var(--vein-x, 30%) 40%, #fff 0, transparent 60%),
			var(--marble);
		box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.06);
	}
	.marble-stack :global(.marble.fresh) {
		animation: settle 0.6s cubic-bezier(0.3, 1.4, 0.5, 1);
	}
	@keyframes settle {
		from {
			transform: translateY(1.2rem) scaleY(1.4);
			filter: brightness(1.3);
		}
	}

	.brick-slots {
		display: flex;
		flex-direction: column-reverse;
		gap: 2px;
		margin-top: 2px;
		padding-top: 2px;
		border-top: 1.5px dashed var(--line);
	}
	.slot {
		display: block;
		height: 0.95rem;
		border: 1px dashed var(--line);
		border-radius: 2px;
		/* staggered courses, like a real wall */
		margin-inline: 0.5rem 0;
	}
	.slot:nth-child(even) {
		margin-inline: 0 0.5rem;
	}
	.slot.filled {
		border: 1px solid var(--brick-edge);
		background:
			linear-gradient(90deg, transparent 49%, rgb(0 0 0 / 0.18) 49% 51%, transparent 51%),
			var(--brick);
	}
	.slot.landing {
		animation: drop 0.38s cubic-bezier(0.5, 0, 0.6, 1.6);
	}
	@keyframes drop {
		from {
			transform: translateY(-2.5rem);
			opacity: 0;
		}
	}
	.bricks:global(.marbling) .slot {
		animation: to-marble 0.65s ease forwards;
	}
	@keyframes to-marble {
		60% {
			background: var(--marble);
			border-color: var(--marble-vein);
			margin-inline: 0;
		}
		100% {
			background: var(--marble);
			border-color: var(--marble-vein);
			margin-inline: 0;
			transform: translateY(-1.5rem);
			opacity: 0;
		}
	}

	.count {
		align-self: flex-end;
		margin-top: 0.45rem;
		white-space: nowrap;
		font-family: var(--font-hand);
		font-size: 1rem;
		line-height: 1.1;
		color: var(--muted);
		text-align: right;
	}

	@media (max-width: 480px) {
		.lay-button {
			font-size: 1.2rem;
			gap: 0.4rem;
			padding: 0.45rem 0.6rem;
		}
		.lay-arrow {
			width: 1.6rem;
		}
		.lay-brick {
			width: 1.8rem;
		}
		.column {
			width: 4.6rem;
		}
	}
</style>
