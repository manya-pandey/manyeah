---
import { MOTTO } from "@/consts";
import SpqrMark from "./SpqrMark.astro";

const chars = [...MOTTO.LATIN];
---

<!--
	Loading screen. Shown once per browser session on the landing page, in
	the current theme. The SPQR mark draws itself, the motto types out
	beneath it, then the English translation takes over (the Latin dims)
	and holds for a couple of seconds before the screen lifts. It lifts when the statue has
	loaded and the motto has finished (or after a timeout, so it never traps
	anyone behind a slow connection).
-->
<div id="loader" class="loader" aria-hidden="true">
	<div class="grain" aria-hidden="true"></div>
	<SpqrMark animated class="mark" />
	<p class="motto">
		{chars.map((c, i) => <span style={`--i: ${i}`}>{c}</span>)}<span
			class="caret"
			style={`--i: ${chars.length}`}>|</span
		>
	</p>
	<p class="translation">{MOTTO.ENGLISH}</p>
</div>

<script is:inline>
	(() => {
		const loader = document.getElementById("loader");
		if (!loader) return;
		let seen = false;
		try {
			seen = sessionStorage.getItem("spqr-seen") === "1";
			sessionStorage.setItem("spqr-seen", "1");
		} catch {}
		if (seen) {
			loader.remove();
			return;
		}
		const shownAt = performance.now();
		const MIN_MS = 5200;
		const MAX_MS = 7000;
		let done = false;
		const lift = () => {
			if (done) return;
			done = true;
			const wait = Math.max(0, MIN_MS - (performance.now() - shownAt));
			setTimeout(() => {
				loader.classList.add("loader--out");
				loader.addEventListener("transitionend", () => loader.remove(), { once: true });
				setTimeout(() => loader.remove(), 900);
			}, wait);
		};
		window.addEventListener("statue:ready", lift, { once: true });
		setTimeout(lift, MAX_MS);
	})();
</script>

<style>
	.loader {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding-inline: 1rem;
		background-color: var(--bg);
		background-image: var(--bg-gradient, none);
		color: var(--ink);
		text-align: center;
		transition:
			opacity 0.7s ease,
			visibility 0.7s;
	}
	.loader--out {
		opacity: 0;
		visibility: hidden;
	}
	.loader :global(.mark) {
		width: min(360px, 70vw);
		margin-bottom: 1rem;
	}

	/* the motto types itself out, letter by letter */
	.motto {
		font-size: clamp(1.05rem, 3.2vw, 1.5rem);
		letter-spacing: 0.02em;
		/* once the translation arrives, the Latin steps back */
		animation: recede 0.6s ease forwards 2.5s;
	}
	.motto span {
		opacity: 0;
		animation: type 0.01s linear forwards;
		animation-delay: calc(1.25s + var(--i) * 28ms);
	}
	.motto .caret {
		color: var(--accent);
		margin-left: 0.05em;
		animation:
			type 0.01s linear forwards,
			blink 0.9s steps(1) infinite;
		animation-delay: calc(1.25s + var(--i) * 28ms), calc(1.25s + var(--i) * 28ms);
	}
	.translation {
		color: var(--accent);
		font-size: clamp(1.1rem, 3.4vw, 1.6rem);
		opacity: 0;
		animation: fade 0.6s ease forwards 2.4s;
	}
	@keyframes type {
		to {
			opacity: 1;
		}
	}
	@keyframes recede {
		to {
			opacity: 0.45;
			transform: scale(0.88);
		}
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@keyframes fade {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
